# cp .env.example .env して値を埋める。.env は .gitignore 済み。
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# 回答生成 (Claude)
ANTHROPIC_API_KEY=

# 埋め込み (Voyage AI)。https://dashboard.voyageai.com で取得
VOYAGE_API_KEY=

# モデル設定（任意。埋め込みモデルを変えたら EMBED_DIM も合わせる）
CHAT_MODEL=claude-opus-4-8
EMBED_MODEL=voyage-3.5
EMBED_DIM=1024

# ハイブリッド検索で使う手法（カンマ区切り）
#   vector,trgm / vector,bm25 / vector,trgm,bm25
RETRIEVERS=vector,trgm

# 回答生成に載せる直近の会話履歴の件数（既定6＝3往復）。
# 0にすると履歴を使わない＝単発の一問一答に戻る
#HISTORY_MESSAGES=6

# リランクの有効化（true/false）。有り/無しを切り替えて精度を比較する
USE_RERANK=false

# リランクの方式。voyage=専用リランクAPI（安い・速い・順位が安定）/
# llm=Claudeに番号を並べ替えさせるプロンプト式（比較用）
RERANK_METHOD=voyage
#RERANK_MODEL=rerank-2      # 速度優先なら rerank-2-lite

# task seed が埋め込みAPIの 429 を受けたときの待ち時間（秒・カンマ区切り）。
# Voyage の無料枠は 3 RPM なので、文書が4件以上あると連続投入で必ず当たる。
#SEED_RETRY_WAITS=20,40,60

# チャンク分割（見出し・条文の構造で切る。app/chunking.py）
#   MAX を超えた節だけ文の切れ目で二次分割し、MIN 未満の節は次とくっつける
CHUNK_MAX_CHARS=1200
CHUNK_MIN_CHARS=200
CHUNK_OVERLAP=200

# contextual retrieval（各チャンクに「文書内での位置づけ」を前置して埋め込む）。
# false にすると Claude を呼ばず、見出しの階層で代用する。効果は eval で比較する
USE_CONTEXTUAL_CHUNKING=true
#CONTEXT_MODEL=claude-opus-4-8   # 未指定なら CHAT_MODEL と同じ
#CONTEXT_CONCURRENCY=4           # 文脈生成の並列数

# 原本保存（S3互換）。ローカルは docker compose の MinIO を使う。
# compose 経由なら backend には自動で渡るので通常ここは書かなくてよい。
# ホストから直接 backend を動かす場合だけ localhost 向きに設定する。
#S3_ENDPOINT_URL=http://localhost:9000
#S3_BUCKET=rag-docs
#AWS_ACCESS_KEY_ID=minioadmin
#AWS_SECRET_ACCESS_KEY=minioadmin

# 文書内画像の抽出（PDFはページ画像、xlsx/pptxは貼られた図。原本はS3へ）。
# 画像を検索対象にするのは次段なので、今は「取り出して保管する」だけ。
#EXTRACT_IMAGES=true
#PDF_RENDER_SCALE=2.0     # 1.0=72dpi。上げると読みやすい代わりに容量・トークン増
#IMAGE_MIN_PIXELS=100     # これ未満の絵は捨てる（ロゴ・罫線・アイコン除け）
#IMAGE_MAX_PER_DOC=50     # 1文書あたりの上限（長大PDFでS3とDBが膨らむのを防ぐ）

# 抽出画像を「テキストの質問で引ける」形にする方式。どちらが良いかは eval で決める。
#   caption    … 案A: Claudeが説明文を書き、既存の3手法(vector/trgm/bm25)で引く
#   multimodal … 案B: 画像を直接ベクトル化し、image 手法で引く
#   none       … 索引を作らない（保管のみ・画像APIのコストを止める）
# 方式を変えたら POST /admin/reindex-images で索引を作り直す（上げ直しは不要）。
IMAGE_INDEX_METHOD=caption
#CAPTION_MODEL=claude-opus-4-8      # 案A。未指定なら CHAT_MODEL と同じ
#CAPTION_CONCURRENCY=4              # 案A。説明文生成の並列数
#MULTIMODAL_EMBED_MODEL=voyage-multimodal-3   # 案B
#MULTIMODAL_EMBED_DIM=1024                    # 案B（列定義に使うので変更は要再作成）

# 公開API(/v1)のレート制限。APIキー1本あたりの「直近1分間の本数」の既定値。
# キーごとの上書きは発行時に: python -m app.apikeys --create --name X --project Y --rate 120
#API_RATE_LIMIT_PER_MIN=60
