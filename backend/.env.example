# cp .env.example .env して値を埋める。.env は .gitignore 済み。
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# 回答生成 (Claude)
ANTHROPIC_API_KEY=

# 埋め込み (Voyage AI)。https://dashboard.voyageai.com で取得
VOYAGE_API_KEY=

# モデル設定（任意。埋め込みモデルを変えたら EMBED_DIM も合わせる）
CHAT_MODEL=claude-opus-4-8
EMBED_MODEL=voyage-3.5
EMBED_DIM=1024

# ハイブリッド検索で使う手法（カンマ区切り）
#   vector,trgm / vector,bm25 / vector,trgm,bm25
RETRIEVERS=vector,trgm

# LLMリランクの有効化（true/false）。有り/無しを切り替えて精度を比較する
USE_RERANK=false
