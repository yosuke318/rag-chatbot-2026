# cp .env.example .env して値を埋める。.env は .gitignore 済み。
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# 回答生成 (Claude)
ANTHROPIC_API_KEY=

# 埋め込み (Voyage AI)。https://dashboard.voyageai.com で取得
VOYAGE_API_KEY=

# モデル設定（任意。埋め込みモデルを変えたら EMBED_DIM も合わせる）
CHAT_MODEL=claude-opus-4-8
EMBED_MODEL=voyage-3.5
EMBED_DIM=1024

# ハイブリッド検索で使う手法（カンマ区切り）
#   vector,trgm / vector,bm25 / vector,trgm,bm25
RETRIEVERS=vector,trgm

# リランクの有効化（true/false）。有り/無しを切り替えて精度を比較する
USE_RERANK=false

# リランクの方式。voyage=専用リランクAPI（安い・速い・順位が安定）/
# llm=Claudeに番号を並べ替えさせるプロンプト式（比較用）
RERANK_METHOD=voyage
#RERANK_MODEL=rerank-2      # 速度優先なら rerank-2-lite

# task seed が埋め込みAPIの 429 を受けたときの待ち時間（秒・カンマ区切り）。
# Voyage の無料枠は 3 RPM なので、文書が4件以上あると連続投入で必ず当たる。
#SEED_RETRY_WAITS=20,40,60

# チャンク分割（見出し・条文の構造で切る。app/chunking.py）
#   MAX を超えた節だけ文の切れ目で二次分割し、MIN 未満の節は次とくっつける
CHUNK_MAX_CHARS=1200
CHUNK_MIN_CHARS=200
CHUNK_OVERLAP=200

# contextual retrieval（各チャンクに「文書内での位置づけ」を前置して埋め込む）。
# false にすると Claude を呼ばず、見出しの階層で代用する。効果は eval で比較する
USE_CONTEXTUAL_CHUNKING=true
#CONTEXT_MODEL=claude-opus-4-8   # 未指定なら CHAT_MODEL と同じ
#CONTEXT_CONCURRENCY=4           # 文脈生成の並列数

# 原本保存（S3互換）。ローカルは docker compose の MinIO を使う。
# compose 経由なら backend には自動で渡るので通常ここは書かなくてよい。
# ホストから直接 backend を動かす場合だけ localhost 向きに設定する。
#S3_ENDPOINT_URL=http://localhost:9000
#S3_BUCKET=rag-docs
#AWS_ACCESS_KEY_ID=minioadmin
#AWS_SECRET_ACCESS_KEY=minioadmin
